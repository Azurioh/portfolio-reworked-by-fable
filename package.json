{
  "name": "portfolio-reworked-by-fable",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "imports": {
    "#shared/*": {
      "browser": "./src/shared/*.ts",
      "development": "./src/shared/*.ts",
      "types": "./src/shared/*.ts",
      "default": "./dist-server/src/shared/*.js"
    },
    "#server/*": {
      "development": "./server/*.ts",
      "types": "./server/*.ts",
      "default": "./dist-server/server/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --conditions=development server/index.ts",
    "build": "tsc && tsc -p tsconfig.node.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "preview": "vite preview",
    "images": "tsx scripts/images.ts",
    "fonts": "tsx scripts/fonts.ts"
  },
  "devDependencies": {
    "@capsizecss/metrics": "^4.3.0",
    "@capsizecss/unpack": "^4.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.2",
    "@types/subset-font": "^2.3.0",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.4",
    "subset-font": "^2.7.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "gsap": "^3.15.0",
    "hono": "^4.13.8",
    "lenis": "^1.3.26",
    "zod": "^4.6.1"
  }
}
