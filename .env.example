# Server (required). Discord → Server settings → Integrations → Webhooks → copy the webhook URL.
# Contact messages are forwarded to this channel as embeds. Never commit the real value.
DISCORD_WEBHOOK_URL=

# Server (optional). HTTP port and directory of the built site served next to the API.
PORT=8787
STATIC_DIR=dist

# Client (optional). Absolute URL of another contact endpoint accepting the same JSON POST.
# Leave empty to use the same-origin `/api/contact` served by this server.
VITE_CONTACT_ENDPOINT=
